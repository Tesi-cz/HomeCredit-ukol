# REGINA — vzor konfigurace
#
# Zkopíruj tento soubor na `.env` a spusť `docker compose up`.
# `.env` je v `.gitignore` a do repozitáře nepatří.
#
#   Copy-Item .env.example .env      (PowerShell)
#   cp .env.example .env             (bash)
#
# Hodnoty níže jsou určené pro LOKÁLNÍ BĚH. Pro reálné nasazení se mění
# databázové přihlášení, tajemství a celá skupina OIDC_* — viz README.

# --- Databáze ---------------------------------------------------------------
# Port databáze se záměrně nepublikuje na hostitele; dosáhne na ni jen aplikace
# po interní síti compose.
POSTGRES_DB=regina
POSTGRES_USER=regina
POSTGRES_PASSWORD=zmen-me-pro-lokalni-beh
DATABASE_URL=postgresql+psycopg://regina:zmen-me-pro-lokalni-beh@db:5432/regina

# --- Session ----------------------------------------------------------------
# Podpis session cookie. Minimálně 32 znaků. Vygeneruj vlastní hodnotu:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=vygeneruj-vlastni-hodnotu-minimalne-32-znaku
# Pro lokální běh po HTTP musí být false, v provozu za HTTPS true.
SESSION_COOKIE_SECURE=false

# --- Adresa aplikace --------------------------------------------------------
BASE_URL=http://localhost:8000

# --- Poskytovatel identity (OIDC) -------------------------------------------
# Aplikace nezná žádnou konkrétní adresu poskytovatele. Vše si zjistí z
# discovery dokumentu na {OIDC_ISSUER}/.well-known/openid-configuration.
# Záměna za Microsoft Entra ID je proto jen změna těchto hodnot.
OIDC_ISSUER=http://host.docker.internal:5556/dex
OIDC_CLIENT_ID=regina
OIDC_CLIENT_SECRET=zmen-me-pro-lokalni-beh
OIDC_SCOPES=openid profile email groups

# Názvy claimů jsou konfigurovatelné, protože každý poskytovatel je pojmenovává
# jinak. Právě to umožňuje záměnu bez zásahu do kódu.
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name
OIDC_ROLE_CLAIM=groups
OIDC_ADMIN_ROLE_VALUE=regina-admins

# --- Evidence ---------------------------------------------------------------
# Útvary jsou uzavřený výčet, ne editovatelný registr.
DEPARTMENTS=Finance,HR,IT Ops,Risk,Marketing,Provoz

# --- Retence (délky jsou zdůvodněné v README) -------------------------------
RETENTION_AUDIT_LOG_DAYS=365
RETENTION_DECOMMISSIONED_APP_DAYS=730
RETENTION_INTERVAL_HOURS=24
RETENTION_ENABLED=true

# --- Klasifikační poradce a AI úprava popisu (classification-advisor) --------
# Volání modelu jde výhradně přes vlastní abstrakci; poskytovatele lze zaměnit
# za firemní AI Gateway pouhou změnou LLM_BASE_URL a LLM_MODEL, bez zásahu do
# kódu.
#
# API KLÍČ JE NEPOVINNÝ. Bez něj aplikace naběhne a poradce běží v mock režimu
# (deterministický návrh bez volání sítě). Reálný klíč vlož jen sem do `.env`
# (tento soubor .env.example zůstává prázdný a je vzorem). Klíč získáš na
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Výběr implementace: "openrouter" nebo "mock". Necháš-li prázdné, zvolí se
# automaticky podle přítomnosti klíče výše (s klíčem openrouter, bez něj mock).
LLM_PROVIDER=

# Adresa poskytovatele a model. Pro firemní AI Gateway se mění jen tyto dvě
# hodnoty. Přesné ID revize modelu si ověř ve svém účtu OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# Řízení "přemýšlení" modelu: off / low / medium / high / auto. Ne-reasoning
# modely (gpt-4o-mini) to ignorují; u reasoning modelů "off" = rychlejší a
# levnější odpověď (bez řetězu úvah). Výchozí "off" drží odezvu svižnou.
LLM_REASONING=off

# Retence dat poradce (dny). Zdůvodnění délek je v README.
RETENTION_LLM_CALL_LOG_DAYS=90
RETENTION_SUGGESTION_DAYS=180

# --- Provoz -----------------------------------------------------------------
LOG_LEVEL=INFO
SEED_ON_START=true
